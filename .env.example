# ============================================================
# Copy this file to `.env` and fill in the values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
# `.env` is git-ignored. NEVER commit real keys.
# ============================================================

# ---------- Runtime ----------
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# ---------- Helius (RPC + WebSocket) ----------
# Just the key — the bot builds the URLs itself.
HELIUS_API_KEY=
# Optional overrides (leave blank to use Helius mainnet defaults)
RPC_HTTP_URL=
RPC_WS_URL=
# Max RPC requests per second the bot will send (stay under your Helius plan limit)
RPC_MAX_RPS=8

# ---------- Database ----------
# Local dev (docker compose exposes Postgres on localhost:5432)
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=solbot
DATABASE_URL=postgresql://bot:change-me-to-something-long@localhost:5432/solbot?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Trading ----------
# PAPER or LIVE. The bot boots in PAPER unless you change this AND confirm in the dashboard.
TRADING_MODE=PAPER
# Base58 private key of the dedicated BOT wallet (Phase 4). Leave blank until then.
BOT_WALLET_PRIVATE_KEY=

# ---------- Dashboard API ----------
API_PORT=8080
# The password you type on the dashboard login screen.
DASHBOARD_PASSWORD=
# Long random string (32+ chars) used to sign login tokens. Just mash the keyboard.
JWT_SECRET=
# Websites allowed to call the API, comma-separated.
# Local: http://localhost:5173   GitHub Pages: https://smaxhy.github.io
CORS_ORIGINS=http://localhost:5173,https://smaxhy.github.io
# VPS only: hostname for HTTPS. Your IP with dashes + .sslip.io
API_DOMAIN=209-250-254-34.sslip.io

# ---------- Scanner tuning ----------
# Turn individual modules on/off without code changes
ENABLE_SCANNER=true
ENABLE_SAFETY_CHECKS=true
ENABLE_OBSERVATIONS=true

# ---------- Later phases (leave blank for now) ----------
ML_SERVICE_URL=http://localhost:8000
TWITTER_BEARER_TOKEN=
ANTHROPIC_API_KEY=
