{
  "name": "solana-trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Pump.fun scanner, evaluator and trader with a learning engine",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "src/db/schema.prisma",
    "seed": "tsx src/db/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "check:rpc": "tsx scripts/check-rpc.ts",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/websocket": "^11.3.3",
    "@jup-ag/api": "^6.0.48",
    "@prisma/client": "6.19.3",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "bullmq": "^6.3.12",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
